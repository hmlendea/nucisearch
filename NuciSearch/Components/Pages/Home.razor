@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject ISearchService SearchService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResources> L

<PageTitle>NuciSearch</PageTitle>

<main>
    <img src="assets/logo.png" alt="NuciSearch logo" class="logo" />
    <p class="title">NuciSearch</p>

    <form @onsubmit="HandleSearch" @onsubmit:preventDefault>
        <div class="tabs">
            <label>
                <input type="radio" name="search-type" value="auto"
                    checked="@searchType.Equals("auto")"
                    @onchange="@(() => searchType = "auto")" />
                @L["Home_Tab_Auto"]
            </label>

            <label>
                <input type="radio" name="search-type" value="text"
                    checked="@searchType.Equals("text")"
                    @onchange="@(() => searchType = "text")" />
                @L["Home_Tab_Text"]
            </label>

            <label>
                <input type="radio" name="search-type" value="images"
                    checked="@searchType.Equals("images")"
                    @onchange="@(() => searchType = "images")" />
                @L["Home_Tab_Images"]
            </label>

            <label>
                <input type="radio" name="search-type" value="torrents"
                    checked="@searchType.Equals("torrents")"
                    @onchange="@(() => searchType = "torrents")" />
                @L["Home_Tab_Torrents"]
            </label>

            <label>
                <input type="radio" name="search-type" value="videos"
                    checked="@searchType.Equals("videos")"
                    @onchange="@(() => searchType = "videos")" />
                @L["Home_Tab_Videos"]
            </label>

            <label>
                <input type="radio" name="search-type" value="maps"
                    checked="@searchType.Equals("maps")"
                    @onchange="@(() => searchType = "maps")" />
                @L["Home_Tab_Locations"]
            </label>
        </div>

        <input
            @bind="searchQuery"
            class="search-box"
            type="text"
            placeholder="@L["Home_SearchPlaceholder"]"
            autocomplete="off"
            autofocus />

        <button class="search-button" type="submit">@L["Home_SearchButton"]</button>
    </form>
</main>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    private string? QueryFromUrl { get; set; }

    private string searchType = "auto";

    private string searchQuery = string.Empty;

    protected override void OnAfterRender(bool isFirstRender)
    {
        if (!isFirstRender)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(QueryFromUrl))
        {
            return;
        }

        string targetUrl = SearchService.GetSearchUrl(QueryFromUrl, searchType);

        if (string.IsNullOrEmpty(targetUrl))
        {
            return;
        }

        NavigationManager.NavigateTo(targetUrl, new NavigationOptions { ForceLoad = true, ReplaceHistoryEntry = true });
    }

    private void HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            return;
        }

        string targetUrl = SearchService.GetSearchUrl(searchQuery, searchType);

        if (string.IsNullOrEmpty(targetUrl))
        {
            return;
        }

        NavigationManager.NavigateTo(targetUrl, new NavigationOptions { ForceLoad = true });
    }
}
